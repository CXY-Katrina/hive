# Copy to .env, or pass --env-file. Values are loaded literally, without shell expansion.
HIVE_MYSQL_HOST=127.0.0.1
HIVE_MYSQL_PORT=3306
HIVE_MYSQL_USER=hive
HIVE_MYSQL_PASSWORD=change-me
HIVE_MYSQL_DATABASE=hive
# Generate with: python -m hive.cli keygen. Keep outside database backups.
HIVE_SECRET_KEY=
HIVE_ADMIN_USERS=admin
HIVE_ORIGIN=http://localhost:5173
# Only set false for local HTTP development; production uses HTTPS.
HIVE_COOKIE_SECURE=false
HIVE_KNOWN_HOSTS=data/known_hosts
HIVE_DATA_DIR=data
